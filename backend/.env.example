# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_workflow?schema=public"

# Authentication (JWT)
JWT_SECRET="development-insecure-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="8h"

# CORS
CLIENT_ORIGIN="http://localhost:5173"

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=5242880
