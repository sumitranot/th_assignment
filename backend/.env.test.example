# Test Environment Configuration
PORT=4001
NODE_ENV=test

# Database Configuration (PostgreSQL Test Database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_workflow_test?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/document_workflow_test?schema=public"

# Authentication (JWT)
JWT_SECRET="test-environment-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="1h"

# CORS
CLIENT_ORIGIN="http://localhost:5173"

# File Storage
UPLOAD_DIR="./uploads_test"
MAX_FILE_SIZE_BYTES=5242880
