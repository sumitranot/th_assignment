# Database Configuration (PostgreSQL: Neon / Supabase / Vercel Postgres / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_workflow?schema=public"

# Authentication (JWT)
JWT_SECRET="development-insecure-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="8h"

# Environment
NODE_ENV="development"
CLIENT_ORIGIN="*"

# File Storage (on Vercel Serverless, defaults automatically to /tmp/uploads)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=5242880

# Optional: Frontend API URL (leave empty on Vercel for automatic same-origin /api)
VITE_API_URL=""
